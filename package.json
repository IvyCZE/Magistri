{
  "name": "bakalari-expressive",
  "private": true,
  "version": "1.6.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "android:assets": "node scripts/generate-android-assets.js && capacitor-assets generate --android --iconBackgroundColor '#10091D' --splashBackgroundColor '#121316' && node scripts/generate-android-vectors.js",
    "release:minor": "node scripts/release.js minor",
    "release:patch": "node scripts/release.js patch",
    "test": "vitest run && node --test server/proxy.test.mjs server/school-directory.test.mjs",
    "android:palettes": "node scripts/export-palettes.js",
    "fixtures:capture": "node scripts/capture-fixtures.mjs",
    "licenses": "node scripts/generate-notices.mjs",
    "licenses:check": "node scripts/generate-notices.mjs --check",
    "check:public": "node scripts/check-public-files.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@types/matter-js": "^0.20.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.18",
    "lucide-react": "^1.37.0",
    "material-shapes-ts": "^0.3.0",
    "matter-js": "^0.20.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.3",
    "parse5": "^8.1.1",
    "postcss": "^8.5.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "license": "GPL-3.0-only",
  "author": "Jan Hrudka (IvyCZ)",
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    },
    "minimatch": "^11.0.9"
  }
}
